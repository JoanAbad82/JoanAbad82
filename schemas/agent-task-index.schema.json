{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/JoanAbad82/JoanAbad82/main/schemas/agent-task-index.schema.json",
  "title": "JoanAbad82 Agent Task Index",
  "type": "object",
  "required": [
    "schema_version",
    "owner",
    "purpose",
    "source_policy",
    "task_count",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "owner": {
      "const": "JoanAbad82"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source_policy": {
      "type": "object",
      "required": [
        "state",
        "label",
        "repositories"
      ],
      "properties": {
        "state": {
          "const": "open"
        },
        "label": {
          "const": "agent-ready"
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[^/]+/[^/]+$"
          }
        }
      },
      "additionalProperties": true
    },
    "task_count": {
      "type": "integer",
      "minimum": 0
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "repository",
          "issue_number",
          "title",
          "url",
          "state",
          "updated_at",
          "task_contract",
          "surface_capabilities",
          "labels",
          "human_review_required"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^[^/]+/[^/]+#[1-9][0-9]*$"
          },
          "repository": {
            "type": "string",
            "pattern": "^[^/]+/[^/]+$"
          },
          "issue_number": {
            "type": "integer",
            "minimum": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "state": {
            "const": "open"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "task_contract": {
            "type": "string",
            "format": "uri"
          },
          "surface_capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "labels": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "human_review_required": {
            "type": "boolean"
          },
          "recommended_review_agent": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
